# =============================================================================
# NeuViTech Labs — BOOTSTRAP CONFIGURATION
# =============================================================================
# These NINE variables are the ENTIRE static configuration surface of the
# system. That is not a starting point to be extended — it is the design.
#
# Everything else — branding, navigation, feature flags, pricing rules, email
# templates, rate limits, SEO defaults, and third-party API keys — lives in the
# database and is changed through the admin UI without a deploy. See
# docs/05-configuration-architecture.md.
#
# Adding a tenth variable requires an ADR, and a test asserts this list.
#
# Why these nine cannot live in the database:
#   you cannot read the database URL from the database, and you cannot decrypt
#   a stored secret without the key that decrypts it.
#
# SETUP:  cp .env.example .env
# The defaults below work for local development unchanged. No real secrets are
# needed until Sprint 7 (payments).
# =============================================================================

# Which settings scope to resolve. local | development | qa | production
ENVIRONMENT=local

# Needed to reach the database.
# Sprint 1: no services yet, this is unused.
# Sprint 2 onward: 'postgres' is the compose service name, not localhost —
# inside a container, localhost is that container.
DATABASE_URL=postgresql+asyncpg://neuvitech:neuvitech@postgres:5432/neuvitech

# Needed before the settings cache exists.
REDIS_URL=redis://redis:6379/0

# Signs sessions. Must exist before any request is served.
# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-not-a-real-secret-replace-in-every-deployed-environment

# Decrypts secret-typed settings stored IN the database.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Losing this makes every stored provider key unrecoverable. Back it up.
ENCRYPTION_KEY=dev-only-not-a-real-key-replace-in-every-deployed-environment

# Bootstraps the first principal. The account is created PENDING — no password
# lives in config — and must complete invitation plus MFA before it can log in.
SUPERUSER_EMAIL=admin@neuvitechlabs.com

# Telemetry must work before the app is healthy enough to report on itself.
# Sprint 1-3: unused. Sprint 4 (NVL-E05) onward: the OTel collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Needed before settings load, so that settings failing to load is debuggable.
LOG_LEVEL=DEBUG

# Injected by CI from the commit SHA. Local value is fine.
APP_VERSION=0.0.0-local
